# Code Muse Board - Environment Configuration Template
# Copy this file to .env and update the values

# ===========================================
# OpenAI Configuration
# ===========================================
# Get your API keys from: https://platform.openai.com/api-keys
# For multiple keys, separate them with commas (no spaces)
# Get your API keys from: https://platform.openai.com/api-keys
# You can use either OPENAI_API_KEY for a single key or OPENAI_API_KEYS for multiple keys
# For multiple keys, use OPENAI_API_KEYS and separate them with commas (no spaces)
OPENAI_API_KEY=your-openai-api-key-here
# Optional: Use OPENAI_API_KEYS for multiple keys
# OPENAI_API_KEYS=key1,key2,key3

# AI Provider Configuration
# ----------------------

# Paid Providers (optional)
ANTHROPIC_API_KEY=your-anthropic-key
COHERE_API_KEY=your-cohere-key

# Free/Open Source Providers
# ----------------------
# HuggingFace (optional, has free tier)
HUGGINGFACE_API_KEY=your-huggingface-key

# Ollama (free, local)
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
USE_OLLAMA=true

# Local Models
USE_LOCAL_MODELS=true
LOCAL_MODELS_CACHE_DIR=./models

# OpenAI Configuration
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=200
OPENAI_TEMPERATURE=0.7

# Provider Selection
USE_FREE_PROVIDERS_FIRST=true
USE_ALTERNATIVE_PROVIDERS=true
CACHE_DURATION=3600 # Cache duration in seconds

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development
HOST=localhost

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/codemuse
# Shadow database for Prisma migrations (required for development)
SHADOW_DATABASE_URL=postgresql://username:password@localhost:5432/codemuse_shadow

# Database Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT=10000

# ===========================================
# Security Configuration
# ===========================================
# Generate strong secrets for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-session-secret-change-this-in-production
BCRYPT_ROUNDS=12

# ===========================================
# News Configuration
# ===========================================
NEWS_CACHE_DURATION=300000
NEWS_FETCH_INTERVAL=600000
NEWS_REALTIME_INTERVAL=30000
NEWS_MAX_ARTICLES_PER_SOURCE=10
NEWS_DUPLICATE_THRESHOLD=0.8

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AI_SUMMARIES=true
ENABLE_REALTIME_FEATURES=true
ENABLE_USER_AUTHENTICATION=false
ENABLE_ANALYTICS=true
ENABLE_DARK_MODE=true
ENABLE_PWA=true

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true

# ===========================================
# Redis Configuration (Optional)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Email Configuration (Future)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@codemuse.com

# ===========================================
# Social Authentication (Future)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===========================================
# Analytics (Future)
# ===========================================
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# ===========================================
# Monitoring (Future)
# ===========================================
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key

# ===========================================
# Development Only
# ===========================================
# Set to true to enable debug logging
DEBUG=false
# Set to true to enable hot reload
HOT_RELOAD=true
# Set to true to enable mock data
USE_MOCK_DATA=false
